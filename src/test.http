### Get all users
GET http://localhost:8080/users

### Create user
POST http://localhost:8080/users
Content-Type: application/json

{
  "username": "rares",
  "password": "1234",
  "email": "rares@email.com",
  "role": "user",
  "score": 0,
  "banned": false
}

### Get user by id
GET http://localhost:8080/users/1

### Update user
PUT http://localhost:8080/users/1
Content-Type: application/json

{
  "username": "rares_updated",
  "password": "newpass",
  "email": "rares_new@email.com",
  "role": "admin",
  "score": 10,
  "banned": false
}

### Delete user
DELETE http://localhost:8080/users/1

GET http://localhost:8080/posts

POST http://localhost:8080/createPost
Content-Type: application/json

{
  "title": "My first post",
  "text": "This is the content of the post",
  "date": "2026-04-02T12:30:00",
  "image": "post1.png",
  "author": {
    "userId": 1
  },
  "tags": []
}

GET http://localhost:8080/1

PUT http://localhost:8080/1?userId=1
Content-Type: application/json

{
  "title": "Updated post title",
  "text": "Updated content",
  "date": "2026-04-02T15:00:00",
  "image": "updated_image.png",
  "author": {
    "userId": 1
  },
  "tags": []
}