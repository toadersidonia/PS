### Get all users
GET http://localhost:8080/users

### Create user
POST http://localhost:8080/users
Content-Type: application/json

{
  "username": "rares",
  "password": "1234",
  "email": "rares@email.com",
  "role": "user",
  "score": 0,
  "banned": false
}

### Create user
POST http://localhost:8080/users
Content-Type: application/json

{
  "username": "alexa",
  "password": "3840",
  "email": "alexa@email.com",
  "role": "user",
  "score": 0,
  "banned": false
}

### Get user by id
GET http://localhost:8080/users/1

### Update user
PUT http://localhost:8080/users/1
Content-Type: application/json

{
  "username": "rares_updated",
  "password": "newpass",
  "email": "rares_new@email.com",
  "role": "admin",
  "score": 10,
  "banned": false
}

### Delete user
DELETE http://localhost:8080/users/2

###

### Create a new post
POST http://localhost:8080/posts?userId=1
Content-Type: application/json

{
  "title": "My first post",
  "text": "This is the content",
  "image": "post1.png"
}

### Create a second post
POST http://localhost:8080/posts?userId=1
Content-Type: application/json

{
"title": "My second post",
"text": "This is the content of the second post",
"image": "post2.png"
}

###

### Get all posts
GET http://localhost:8080/posts
Accept: application/json

### Get post by ID
GET http://localhost:8080/posts/1
Accept: application/json


### Update post
PUT http://localhost:8080/posts/1?userId=1
Content-Type: application/json

{
  "title": "Updated post title",
  "text": "Updated content",
  "image": "updated_image.png"
}

### Delete post
DELETE http://localhost:8080/posts/2?userId=1

###

### Create a comment
POST http://localhost:8080/comments?postId=1&userId=1
Content-Type: application/json

{
  "text": "Comentariu de test",
  "image": "https://example.com/image.png"
}

### Create a comment
POST http://localhost:8080/comments?postId=1&userId=1
Content-Type: application/json

{
  "text": "Comentariu de test 2",
  "image": "https://example2.com/image.png"
}

###

### Retrieve all comments for a post
GET http://localhost:8080/comments/post/1
Accept: application/json

###

### Retrieve single comment by id
GET http://localhost:8080/comments/1
Accept: application/json

###

### Update a comment
PUT http://localhost:8080/comments/1?userId=1
Content-Type: application/json

{
  "text": "Comentariu modificat",
  "image": "https://example.com/updated_image.png"
}

###

### Delete a comment
DELETE http://localhost:8080/comments/2?userId=1


###
### ----- AUTH TESTS -----
###

### Register - creeaza user nou
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "username": "raresnou",
  "email": "raresnou@test.com",
  "password": "parola123"
}

### Login - autentificare
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "raresnou",
  "password": "parola123"
}

### Login cu parola gresita (trebuie sa dea eroare)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "raresnou",
  "password": "gresita"
}

###

### ----- MODERATOR TESTS -----
###

### Ban user (id 2)
PUT http://localhost:8080/users/2/ban

###

### Login cu user banat
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "raresnou",
  "password": "parola123"
}

###

### Unban user (id 2)
PUT http://localhost:8080/users/2/unban

###

### Login dupa unban
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "raresnou",
  "password": "parola123"
}

###

### Change role to MODERATOR
PUT http://localhost:8080/users/2/role
Content-Type: application/json

{
  "role": "MODERATOR"
}